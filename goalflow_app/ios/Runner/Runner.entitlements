<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. Xcode rewrites this to "production" for App Store and
	     TestFlight builds; "development" is what a local debug build needs.
	     Push on a physical iPhone also requires an APNs key uploaded to the
	     Firebase project (Settings > Cloud Messaging). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
