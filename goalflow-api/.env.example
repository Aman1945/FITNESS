# ---- Server ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
APP_DEEP_LINK=goalflow://

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/goalflow
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/goalflow

# ---- Auth ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Resend (transactional email) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="GoalFlow <onboarding@resend.dev>"
# Set to true in dev to print emails to the console instead of sending
EMAIL_DRY_RUN=true

# ---- Firebase Cloud Messaging (push) ----
# Service account JSON from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Leave blank to disable push (server logs the payload instead)

# ---- Jobs ----
ENABLE_CRON=true
MATERIALISE_DAYS_AHEAD=7

# ---- Optional: self-ping to stop a free host sleeping ----
# Must be this service's PUBLIC url. A loopback ping does not count as inbound
# traffic, so localhost will not work. Cannot wake the service once it HAS slept
# -- an external scheduler is more reliable. Leave blank to disable.
# KEEP_AWAKE_URL=https://your-service.onrender.com/health
KEEP_AWAKE_MINUTES=10
